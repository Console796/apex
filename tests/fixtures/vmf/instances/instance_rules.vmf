// Apex-authored instance fixup and collapse fixture (MIT).
world
{
    "id" "1"
    "classname" "worldspawn"
    solid
    {
        "id" "2"
        side
        {
            "id" "3"
            "plane" "(0 0 0) (0 1 0) (1 1 0)"
            "material" "$var/panel"
            "uaxis" "[1 0 0 0] 0.25"
            "vaxis" "[0 -1 0 0] 0.25"
        }
    }
}
entity
{
    "id" "4"
    "classname" "prop_dynamic"
    "targetname" "model"
    "model" "models/$var.mdl"
    "skin" "$skin"
    "origin" "1 0 0"
    "angles" "0 0 0"
}
entity
{
    "id" "5"
    "classname" "func_instance_parms"
    "param01" "$skin integer 0"
}
entity
{
    "id" "6"
    "classname" "func_instance_io_proxy"
    "targetname" "proxy"
    connections
    {
        "OnProxyRelay" "model,Enable,proxy parameter,0.5,2"
    }
}
entity
{
    "id" "7"
    "classname" "logic_relay"
    "targetname" "relay"
    connections
    {
        "OnTrigger" "proxy,ProxyRelay,inside,0.25,-1"
    }
}
