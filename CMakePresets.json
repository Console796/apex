{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "linux-gcc",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "linux-clang",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "windows-msvc",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_CXX_COMPILER": "cl" }
    },
    { "name": "linux-gcc-debug", "inherits": "linux-gcc", "displayName": "Linux GCC Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "linux-gcc-release", "inherits": "linux-gcc", "displayName": "Linux GCC Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" } },
    { "name": "linux-clang-debug", "inherits": "linux-clang", "displayName": "Linux Clang Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "linux-clang-release", "inherits": "linux-clang", "displayName": "Linux Clang Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" } },
    { "name": "linux-asan", "inherits": "linux-gcc", "displayName": "Linux GCC ASan+UBSan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "APEX_SANITIZE": "address;undefined" } },
    { "name": "linux-fuzz", "inherits": "linux-clang", "displayName": "Linux Clang libFuzzer",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "APEX_BUILD_APP": "OFF",
                          "APEX_BUILD_TESTS": "OFF", "APEX_BUILD_FUZZ": "ON" } },
    { "name": "windows-msvc-debug", "inherits": "windows-msvc", "displayName": "Windows MSVC Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "windows-msvc-release", "inherits": "windows-msvc", "displayName": "Windows MSVC Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" } }
  ],
  "buildPresets": [
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release" },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "linux-fuzz", "configurePreset": "linux-fuzz" },
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" }
  ],
  "testPresets": [
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug",
      "output": { "outputOnFailure": true } },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release",
      "output": { "outputOnFailure": true } },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug",
      "output": { "outputOnFailure": true } },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release",
      "output": { "outputOnFailure": true } },
    { "name": "linux-asan", "configurePreset": "linux-asan",
      "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug",
      "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release",
      "output": { "outputOnFailure": true } }
  ]
}
